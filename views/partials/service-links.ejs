<%# expects: town (optional), exclude (optional slug) %>
<div class="grid-3">
  <% services.filter(s => !(typeof exclude !== 'undefined' && s.slug === exclude)).forEach(s => { %>
  <a class="card-img card-link" href="<%= typeof town !== 'undefined' && town ? stUrl(s, town) : svcUrl(s) %>">
    <img src="<%= img(s.card, 800) %>" loading="lazy" decoding="async" alt="<%= s.name %><%= typeof town !== 'undefined' && town ? ' in ' + town.name + ', MA' : ' on Cape Cod' %>">
    <div class="card-body">
      <h3 style="font-size:21px"><%= s.name %><%= typeof town !== 'undefined' && town ? ' in ' + town.name : '' %></h3>
      <p class="muted mt-s" style="font-size:15px"><%= s.cardLine %></p>
      <span class="more chev">Learn more</span>
    </div>
  </a>
  <% }) %>
</div>
