<% if (breadcrumbs && breadcrumbs.length) { %>
<nav class="crumbs wrap" aria-label="Breadcrumb"><ol>
  <li><a href="/">Home</a></li>
  <% breadcrumbs.forEach((b, i) => { %><li><% if (i === breadcrumbs.length - 1) { %><span aria-current="page"><%= b.name %></span><% } else { %><a href="<%= b.url %>"><%= b.name %></a><% } %></li><% }) %>
</ol></nav>
<% } %>
