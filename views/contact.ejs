<%- include('partials/head') %>
<main id="main">
  <%- include('partials/crumbs') %>
  <section class="page-hero" style="padding-bottom:10px">
    <div class="wrap">
      <span class="eyebrow">Free estimates</span>
      <h1 class="h1">Let’s talk about your project.</h1>
      <p class="lede">Tell us what you have in mind — tree work, a patio, a retaining wall, demolition or firewood — and we’ll get back to you quickly.</p>
    </div>
  </section>
  <section class="section" style="padding-top:60px">
    <div class="wrap contact-grid">
      <div class="contact-info">
        <div class="card alt" style="background:var(--bg-alt)">
          <dl style="margin:0">
            <dt>Phone</dt><dd><a class="phone-big" href="<%= biz.phoneHref %>"><%= biz.phone %></a></dd>
            <dt>Email</dt><dd><a href="mailto:<%= biz.email %>"><%= biz.email %></a></dd>
            <dt>Address</dt><dd><%= biz.street %><br><%= biz.city %>, <%= biz.state %> <%= biz.zip %></dd>
            <dt>Service area</dt><dd style="margin-bottom:0">Cape Cod & the South Shore — <%= biz.coverage %></dd>
          </dl>
        </div>
        <div class="card" style="background:var(--dark);color:var(--on-dark)">
          <h3>Storm damage?</h3>
          <p style="color:var(--on-dark-2)">For emergency tree removal, call us directly — don’t wait on a form.</p>
          <a class="btn btn-primary mt" href="<%= biz.phoneHref %>">Call <%= biz.phone %></a>
        </div>
        <div class="map mt">
          <iframe title="Map to Travers Group, 152 Cranberry Highway, Bourne MA" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://maps.google.com/maps?q=<%= encodeURIComponent(biz.street + ', ' + biz.city + ', ' + biz.state + ' ' + biz.zip) %>&z=13&output=embed"></iframe>
        </div>
      </div>
      <div class="form-shell">
        <form class="leadform" id="estimate" method="post" action="/api/lead" novalidate>
          <h2 class="leadform__title">Request a free estimate</h2>
          <p class="leadform__sub">We’ll call you back to set up a time to walk the property.</p>
          <input type="hidden" name="page" value="/contact">
          <div class="hp" aria-hidden="true"><label>Website <input name="company_website" tabindex="-1" autocomplete="off"></label></div>
          <div class="fld-row">
            <label class="fld"><span>Name</span><input name="name" autocomplete="name" required></label>
            <label class="fld"><span>Phone</span><input name="phone" type="tel" autocomplete="tel" inputmode="tel" required></label>
          </div>
          <label class="fld"><span>Email <em>(optional)</em></span><input name="email" type="email" autocomplete="email"></label>
          <label class="fld"><span>Project address <em>(optional)</em></span><input name="address" autocomplete="street-address"></label>
          <div class="fld-row">
            <label class="fld"><span>Town</span>
              <select name="town">
                <option value="">Select your town</option>
                <% towns.forEach(t => { %><option value="<%= t.slug %>" <%= preTown === t.slug ? 'selected' : '' %>><%= t.name %></option><% }) %>
                <option value="Other">Other</option>
              </select></label>
            <label class="fld"><span>Service</span>
              <select name="service">
                <option value="">Not sure yet</option>
                <% services.forEach(s => { %><option value="<%= s.slug %>" <%= preService === s.slug ? 'selected' : '' %>><%= s.name %></option><% }) %>
              </select></label>
          </div>
          <label class="fld"><span>Tell us about the project</span><textarea name="message" rows="4"></textarea></label>
          <div class="fld-row">
            <label class="fld"><span>Best way to reach you</span>
              <select name="contact_pref"><option>Call</option><option>Text</option><option>Email</option></select></label>
            <label class="chk"><input type="checkbox" name="urgent" value="yes"> Storm damage / urgent</label>
          </div>
          <button class="btn btn-primary leadform__btn" type="submit">Get my free estimate</button>
          <p class="leadform__msg" role="status" aria-live="polite"></p>
          <p class="leadform__fine">By submitting you agree to be contacted by Travers Group about your request by phone, text or email. Msg &amp; data rates may apply. Reply STOP to opt out.</p>
        </form>
        <div class="leadform__done" hidden>
          <h2 class="leadform__title">Thanks — we got it.</h2>
          <p>We’ll be in touch shortly. Need us sooner? Call <a href="<%= biz.phoneHref %>"><%= biz.phone %></a>.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap">
      <div class="section-head reveal"><span class="eyebrow">Services</span><h2 class="h2">What can we help with?</h2></div>
      <div class="mt-l reveal"><%- include('partials/service-links') %></div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
